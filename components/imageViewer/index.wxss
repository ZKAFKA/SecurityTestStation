/* components/imageViewer/index.wxss */

.image-viewer-container {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.9);
  z-index: 999999;
  display: flex;
  flex-direction: column;
}

.image-viewer-content {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  padding: 20rpx;
}

.image-wrapper {
  transition: transform 0.2s ease;
  max-width: 100%;
  max-height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.viewer-image-container {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  touch-action: none;
}

.viewer-image {
  width: 100%;
  max-height: 100%;
  display: block;
}

.image-loading-fullscreen {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  background-color: rgba(0, 0, 0, 0.7);
  color: #fff;
  padding: 30rpx 60rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
}

.image-error-fullscreen {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  background-color: rgba(0, 0, 0, 0.7);
  color: #ff6b6b;
  padding: 30rpx 60rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
  text-align: center;
}

.image-error-fullscreen .retry-btn {
  margin-top: 20rpx;
  background-color: #4ecdc4;
  color: #fff;
  border: none;
  padding: 15rpx 30rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
}