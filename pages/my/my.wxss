/* pages/my.wxss */

page {
  background: linear-gradient(180deg, #090D16 0%, #0d172e 40%, #090D16 100%);
  min-height: 100vh;
  color: #E2E8F0;
}

.page {
  min-height: 100vh;
}

.content-wrap {
  padding: 24rpx 28rpx 48rpx;
}

/* ==================== 用户信息卡 ==================== */
.user-profile-card {
  position: relative;
  background: #0f172a;
  border-radius: 32rpx;
  padding: 36rpx 32rpx 32rpx;
  border: 2rpx solid rgba(56, 189, 248, 0.15);
  overflow: hidden;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.4);
  margin-bottom: 28rpx;
}

/* 背景图 */
.card-bg-img {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  opacity: 1;
}

/* 半透明深色遮罩，保证前景文字可读 */
.card-bg-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
  background: linear-gradient(160deg, rgba(9, 13, 22, 0.78) 0%, rgba(15, 23, 42, 0.72) 50%, rgba(15, 23, 42, 0.85) 100%);
}

.card-glow-deco {
  position: absolute;
  right: -40rpx;
  top: -40rpx;
  width: 240rpx;
  height: 240rpx;
  background: radial-gradient(circle, rgba(37, 99, 235, 0.3) 0%, rgba(6, 182, 212, 0.15) 50%, rgba(15, 23, 42, 0) 70%);
  pointer-events: none;
}

.user-header {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  margin-bottom: 28rpx;
}

/* 头像 */
.avatar-ring {
  position: relative;
  width: 128rpx;
  height: 128rpx;
  flex-shrink: 0;
}

.avatar-ring::before {
  content: '';
  position: absolute;
  top: -4rpx;
  left: -4rpx;
  right: -4rpx;
  bottom: -4rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #2563eb 0%, #06b6d4 50%, #6366f1 100%);
  box-shadow: 0 0 24rpx rgba(6, 182, 212, 0.4);
}

.avatar-inner {
  position: absolute;
  top: 4rpx;
  left: 4rpx;
  right: 4rpx;
  bottom: 4rpx;
  border-radius: 50%;
  background: #0b1329;
  border: 2rpx solid rgba(6, 182, 212, 0.3);
  overflow: hidden;
}

.avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.verified-badge {
  position: absolute;
  right: -4rpx;
  bottom: -4rpx;
  width: 40rpx;
  height: 40rpx;
  background: #3b82f6;
  border-radius: 50%;
  border: 4rpx solid #0f172a;
  display: flex;
  align-items: center;
  justify-content: center;
}

.verified-check {
  color: #ffffff;
  font-size: 22rpx;
  font-weight: bold;
}

/* 用户信息 */
.user-info-block {
  flex: 1;
  margin-left: 28rpx;
  min-width: 0;
}

.user-nickname {
  font-size: 36rpx;
  font-weight: bold;
  color: #ffffff;
  display: block;
  margin-bottom: 10rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.user-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.meta-uid {
  font-size: 22rpx;
  color: #94a3b8;
  font-family: monospace;
}

.meta-dot {
  font-size: 22rpx;
  color: #475569;
  margin: 0 10rpx;
}

.meta-checkin {
  display: flex;
  align-items: center;
}

.checkin-icon {
  color: #06b6d4;
  font-size: 20rpx;
  margin-right: 6rpx;
  font-weight: bold;
}

.checkin-text {
  font-size: 22rpx;
  color: #67e8f9;
  font-weight: 500;
}

/* 统计条 */
.stats-strip {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.06);
  border-radius: 24rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.08);
  padding: 28rpx 0;
}

.stats-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stats-label {
  font-size: 20rpx;
  color: #94a3b8;
  font-weight: 500;
  letter-spacing: 2rpx;
  margin-bottom: 6rpx;
}

.stats-num-wrap {
  display: flex;
  align-items: baseline;
}

.stats-num {
  font-size: 40rpx;
  font-weight: 900;
  color: #ffffff;
  line-height: 1.1;
}

.stats-num-accent {
  color: #67e8f9;
}

.stats-unit {
  font-size: 20rpx;
  color: #94a3b8;
  margin-left: 4rpx;
}

.stats-sep {
  width: 2rpx;
  height: 48rpx;
  background: rgba(255, 255, 255, 0.12);
}

/* ==================== 快捷入口 ==================== */
.shortcut-grid {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 28rpx;
}

.shortcut-card {
  flex: 1;
  min-width: 0;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
  border: 2rpx solid #f1f5f9;
}

.shortcut-card:active {
  transform: scale(0.97);
  opacity: 0.9;
}

.shortcut-icon-wrap {
  position: relative;
  width: 88rpx;
  height: 88rpx;
  border-radius: 20rpx;
  background: #fef2f2;
  border: 2rpx solid #fee2e2;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}

.sc-amber-wrap {
  background: #fffbeb;
  border-color: #fef3c7;
}

.sc-blue-wrap {
  background: #eff6ff;
  border-color: #dbeafe;
}

.shortcut-icon-img {
  width: 40rpx;
  height: 40rpx;
}

.shortcut-title {
  font-size: 24rpx;
  font-weight: bold;
  color: #0f172a;
  margin-bottom: 4rpx;
}

.shortcut-desc {
  font-size: 20rpx;
  color: #94a3b8;
}

/* ==================== 当前备考目标 ==================== */
.exam-target-card {
  position: relative;
  background: #0f172a;
  border-radius: 32rpx;
  padding: 30rpx 24rpx;
  margin-bottom: 24rpx;
  border: 2rpx solid rgba(56, 189, 248, 0.15);
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.4);
  overflow: hidden;
}

.card-glow-purple {
  position: absolute;
  right: -40rpx;
  top: -40rpx;
  width: 200rpx;
  height: 200rpx;
  background: radial-gradient(circle, rgba(99, 102, 241, 0.25) 0%, rgba(139, 92, 246, 0.1) 45%, rgba(15, 23, 42, 0) 70%);
  pointer-events: none;
}

/* 紧凑横向一行 */
.target-compact {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
}

/* 左：标题竖条 + 文字 */
.target-side {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.target-title-bar {
  width: 6rpx;
  height: 28rpx;
  background: linear-gradient(180deg, #38bdf8 0%, #6366f1 100%);
  border-radius: 3rpx;
  margin-right: 12rpx;
}

.target-title {
  font-size: 26rpx;
  font-weight: bold;
  color: #ffffff;
  white-space: nowrap;
}

/* 中：考试缩写 + 进度条 */
.target-main {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.target-exam-name {
  font-size: 26rpx;
  font-weight: bold;
  color: #ffffff;
  white-space: nowrap;
  flex-shrink: 0;
}

.progress-row {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
}

.progress-pct {
  font-size: 20rpx;
  font-weight: bold;
  color: #67e8f9;
  font-family: monospace;
  flex-shrink: 0;
}

.progress-bar-bg {
  flex: 1;
  height: 10rpx;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 10rpx;
  overflow: hidden;
  min-width: 0;
}

.progress-bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #3b82f6 0%, #06b6d4 100%);
  border-radius: 10rpx;
  transition: width 0.6s ease;
  box-shadow: 0 0 8rpx rgba(6, 182, 212, 0.4);
}

/* 右：倒计时 */
.target-countdown {
  flex-shrink: 0;
  display: flex;
  align-items: baseline;
  padding-left: 20rpx;
  margin-left: 16rpx;
  border-left: 2rpx solid rgba(255, 255, 255, 0.1);
}

.countdown-num {
  font-size: 36rpx;
  font-weight: 900;
  color: #ef4444;
  line-height: 1;
  text-shadow: 0 0 12rpx rgba(239, 68, 68, 0.3);
}

.countdown-unit {
  font-size: 20rpx;
  color: #94a3b8;
  margin-left: 4rpx;
}

/* 空状态 */
.target-empty {
  flex: 1;
  display: flex;
  align-items: center;
  padding-left: 12rpx;
}

.target-empty-text {
  font-size: 26rpx;
  color: #64748b;
}

.target-empty-right {
  flex-shrink: 0;
  width: 56rpx;
  height: 56rpx;
  border: 2rpx dashed rgba(56, 189, 248, 0.4);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 16rpx;
}

.target-empty-plus {
  font-size: 32rpx;
  color: #38bdf8;
  font-weight: bold;
  line-height: 1;
}

/* ==================== 设置列表 ==================== */
.settings-card {
  background: #ffffff;
  border-radius: 28rpx;
  border: 2rpx solid #f1f5f9;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
  overflow: hidden;
}

.settings-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 32rpx;
  border-bottom: 2rpx solid #f1f5f9;
}

.settings-item:last-child {
  border-bottom: none;
}

.settings-item:active {
  background: #f8fafc;
}

.settings-item-left {
  display: flex;
  align-items: center;
}

.settings-icon-wrap {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.si-blue {
  background: #eff6ff;
  color: #3b82f6;
}

.si-indigo {
  background: #eef2ff;
  color: #6366f1;
}

.si-gray {
  background: #f1f5f9;
  color: #64748b;
}

.settings-icon {
  font-size: 28rpx;
}

.settings-icon-img {
  width: 38rpx;
  height: 38rpx;
}

/* 打卡提醒开关：缩小 */
.reminder-switch {
  transform: scale(0.78);
  transform-origin: right center;
}

.settings-title-wrap {
  display: flex;
  flex-direction: column;
}

.settings-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #0f172a;
}

.settings-subtitle {
  font-size: 20rpx;
  color: #94a3b8;
  margin-top: 4rpx;
}

.settings-item-right {
  display: flex;
  align-items: center;
}

.settings-right-text {
  font-size: 22rpx;
  color: #94a3b8;
  margin-right: 6rpx;
}

.settings-right-version {
  font-family: monospace;
}

.settings-arrow {
  font-size: 32rpx;
  color: #94a3b8;
  line-height: 1;
}

/* ==================== 考试目标设置弹窗 ==================== */
.target-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.target-modal-panel {
  width: 640rpx;
  background: #0f172a;
  border-radius: 32rpx;
  overflow: hidden;
  border: 2rpx solid rgba(56, 189, 248, 0.2);
  box-shadow: 0 32rpx 80rpx rgba(0, 0, 0, 0.6);
}

.target-modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 32rpx 20rpx;
}

.target-modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #ffffff;
}

.target-modal-close {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #64748b;
  font-size: 28rpx;
}

.target-modal-body {
  padding: 8rpx 32rpx 28rpx;
}

.target-modal-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
}

.target-modal-label {
  font-size: 26rpx;
  color: #94a3b8;
  flex-shrink: 0;
}

.target-picker-value {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.08);
  border: 2rpx solid rgba(56, 189, 248, 0.2);
  padding: 12rpx 20rpx;
  border-radius: 12rpx;
  min-width: 260rpx;
  justify-content: space-between;
}

.target-picker-text {
  font-size: 24rpx;
  color: #67e8f9;
  max-width: 200rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.target-picker-arrow {
  font-size: 28rpx;
  color: #67e8f9;
  margin-left: 8rpx;
  line-height: 1;
}

/* 底部按钮 */
.target-modal-footer {
  display: flex;
  border-top: 2rpx solid rgba(255, 255, 255, 0.06);
}

.target-modal-btn {
  flex: 1;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 500;
}

.btn-cancel {
  color: #94a3b8;
  border-right: 2rpx solid rgba(255, 255, 255, 0.06);
}

.btn-confirm {
  color: #67e8f9;
  font-weight: bold;
}

/* ==================== 备考资料弹窗 ==================== */
.material-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.material-modal-panel {
  position: relative;
  width: 600rpx;
  background: #0f172a;
  border-radius: 32rpx;
  border: 2rpx solid rgba(56, 189, 248, 0.2);
  box-shadow: 0 32rpx 80rpx rgba(0, 0, 0, 0.6);
  padding: 48rpx 40rpx 44rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.material-modal-close {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #64748b;
  font-size: 28rpx;
}

.material-modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #ffffff;
  margin-bottom: 32rpx;
}

.material-qrcode-wrap {
  width: 380rpx;
  height: 380rpx;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 20rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
}

.material-qrcode {
  width: 100%;
  height: 100%;
}

.material-modal-tip {
  margin-top: 28rpx;
  font-size: 26rpx;
  color: #67e8f9;
}

.material-modal-desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #94a3b8;
  text-align: center;
  line-height: 36rpx;
}

/* 联系我们弹窗：说明文字 */
.contact-modal-desc {
  margin: 8rpx 0 32rpx;
  font-size: 26rpx;
  color: #94a3b8;
  text-align: center;
  line-height: 40rpx;
}