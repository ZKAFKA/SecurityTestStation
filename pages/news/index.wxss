/* pages/news/index.wxss */
.news_page {
  background-color: #f5f5f5;
  min-height: 100vh;
  padding: 20rpx;
}

.qrcode_container {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 40rpx 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.qrcode_image {
  width: 300rpx;
  height: 300rpx;
  margin-bottom: 24rpx;
}

.qrcode_text {
  text-align: center;
  max-width: 100%;
}

.qrcode_title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333333;
  display: block;
  margin-bottom: 16rpx;
}

.qrcode_subtitle {
  font-size: 24rpx;
  color: #666666;
  line-height: 38rpx;
  display: block;
  margin-bottom: 16rpx;
}

.qrcode_hint {
  font-size: 20rpx;
  color: #999999;
  line-height: 32rpx;
  display: block;
  margin-top: 8rpx;
}

.news_list {
  padding: 0;
}